[Unit]
Description=Run the Claude factory dispatcher every 2 minutes

[Timer]
# Fixed clock times (:00, :02, :04, ...) on every machine, so the "offset" line
# in repos.conf (under 120 seconds) keeps two machines from claiming cards at the
# same moment. Every 2 minutes, not 5 (2026-11-05): a tick that finds nothing
# costs only the Linear and GitHub reads, and the wait between a card going
# Ready For Factory, or a PR going red or conflicted, and the factory acting on
# it was most of a card's idle time. A session ending also starts a tick about
# 20 seconds later (claude-factory-mark-done), so follow-up work doesn't wait.
OnCalendar=*:0/2
AccuracySec=1s

[Install]
WantedBy=timers.target
