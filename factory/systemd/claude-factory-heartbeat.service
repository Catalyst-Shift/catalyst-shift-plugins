# CAT-1442: posts this machine's heartbeat to the board every 60 seconds and
# within 5 seconds of a change, while claude-factory.timer is active. It starts
# and stops with the timer, so a stopped dispatcher goes silent on the board.
# Without FACTORY_INGEST_TOKEN it sends nothing.
[Unit]
Description=Claude factory heartbeat to the board (stops with claude-factory.timer)
After=network-online.target claude-factory.timer
PartOf=claude-factory.timer

[Service]
Type=simple
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
ExecStart=%h/.local/bin/claude-factory-stream heartbeat
Restart=always
RestartSec=30

[Install]
WantedBy=claude-factory.timer
